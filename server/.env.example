# LoopTalk server configuration. Nothing here is required to start the server.
#
# On first start the server generates JWT_SECRET, USER_DATA_ENCRYPTION_KEY and the web-push
# VAPID key pair, and keeps them in "<database file>.secrets.json" beside the SQLite database.
# Back that file up together with the database. Values set here or in the host environment
# always take precedence, so existing deployments keep their secrets.

# SQLite database file. Defaults to file:./looptalk.db (inside server/prisma);
# the Docker image uses file:/data/looptalk.db on the persistent /data volume.
DATABASE_URL="file:./looptalk.db"

# ---------------------------------------------------------------------------
# Production: set these once the native apps are signed and moderators exist.
# ---------------------------------------------------------------------------

# Universal/app-link verification served at /.well-known (404 until set).
APPLE_TEAM_ID=""
ANDROID_CERT_SHA256=""

# Coturn REST credentials so calls connect on restrictive networks. Set both or neither.
TURN_URLS=""
TURN_SECRET=""

# Comma-separated user IDs allowed to review abuse reports.
ADMIN_USER_IDS=""

# ---------------------------------------------------------------------------
# Optional overrides. Defaults are shown; uncomment only to change them.
# ---------------------------------------------------------------------------

# Crash reporting. RELEASE_VERSION defaults to server/package.json "version".
# SENTRY_DSN=""
# RELEASE_VERSION=""

# Number of reverse proxies in front of the server (nginx/Hostinger = 1).
# TRUST_PROXY=""

# Public origin (defaults to https://looptalk.net in production) and extra CORS origins.
# PUBLIC_URL="https://looptalk.net"
# CORS_ORIGIN=""

# Apple/Google sign-in audiences (comma-separated). Apple defaults to the bundle ID
# com.looptalk.app; Google defaults to EXPO_PUBLIC_GOOGLE_{WEB,IOS,ANDROID}_CLIENT_ID.
# Set a variable to "" to turn that provider off.
# APPLE_CLIENT_IDS="com.looptalk.app"
# GOOGLE_CLIENT_IDS=""
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""

# Expo push access token, only when Expo "enhanced push security" is enabled.
# EXPO_ACCESS_TOKEN=""

# Web-push contact. The VAPID key pair itself is generated automatically.
# VAPID_SUBJECT="mailto:admin@looptalk.net"

# Optional published desktop installer folder; unset links open the web app.
# DESKTOP_DOWNLOAD_BASE_URL=""

# Limits, network and storage.
# PORT=3001
# HOST=""
# UPLOAD_DIR=""
# DAILY_INVITATION_LIMIT=1000
# REQUEST_TIMEOUT_MS=1800000
# REDIS_URL=""
