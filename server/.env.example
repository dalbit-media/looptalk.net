DATABASE_URL="mysql://user:password@localhost:3306/looptalk?connection_limit=10&pool_timeout=20"
JWT_SECRET="replace-with-a-long-random-production-secret"
CORS_ORIGIN="https://app.example.com"
PUBLIC_URL="https://api.looptalk.app"
INSTANCE_COUNT=1
REDIS_URL=""

# Coturn REST API credentials. TURN_URLS may contain comma-separated UDP/TCP/TLS URLs.
TURN_URLS="turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349"
TURN_SECRET="replace-with-the-coturn-static-auth-secret"

# Optional Expo push access token when enhanced push security is enabled
EXPO_ACCESS_TOKEN=""

# Max invitations that can be generated platform-wide within a rolling 24h window
DAILY_INVITATION_LIMIT=1000

# Social sign-in (leave blank to disable a provider)
GOOGLE_WEB_CLIENT_ID=""
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""
APPLE_CLIENT_ID="com.looptalk.app"

# Production crash reporting and release correlation
SENTRY_DSN=""
RELEASE_VERSION="1.0.0"

# Comma-separated User IDs allowed to review abuse reports
ADMIN_USER_IDS=""

# Native signing identifiers used by universal/app link verification
APPLE_TEAM_ID=""
ANDROID_CERT_SHA256=""
