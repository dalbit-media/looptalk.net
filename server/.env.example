# Optional. Defaults to file:./looptalk.db when omitted.
# SQLite examples:
# - custom local database: file:./custom.db
# - production: file:/data/looptalk.db
DATABASE_URL="file:./looptalk.db"
PORT=3001
# Optional for local development. Required in production and must be at least 32 characters.
JWT_SECRET=""
# Required in every environment: persistent secret, exactly 32 random bytes encoded as base64.
# Provision via your secret manager; never rotate without migrating encrypted contacts and lookup indexes.
USER_DATA_ENCRYPTION_KEY=""
INSTANCE_COUNT=1
REDIS_URL=""

# Optional. Leave empty for same-origin deployments.
# Examples:
# CORS_ORIGIN="https://app.looptalk.net,https://admin.looptalk.net"
CORS_ORIGIN=""

# Coturn REST API credentials. TURN_URLS may contain comma-separated UDP/TCP/TLS URLs.
TURN_URLS=""
TURN_SECRET=""

# Optional Expo push access token when enhanced push security is enabled
EXPO_ACCESS_TOKEN=""

# Max invitations that can be generated platform-wide within a rolling 24h window
DAILY_INVITATION_LIMIT=1000

# Social sign-in (leave blank to disable a provider)
GOOGLE_WEB_CLIENT_ID=""
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""
APPLE_CLIENT_ID="com.looptalk.app"

# Production crash reporting and release correlation
SENTRY_DSN=""
RELEASE_VERSION="1.0.0"

# Comma-separated User IDs allowed to review abuse reports
ADMIN_USER_IDS=""

# Native signing identifiers used by universal/app link verification
APPLE_TEAM_ID=""
ANDROID_CERT_SHA256=""
