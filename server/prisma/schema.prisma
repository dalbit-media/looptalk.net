// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String @id @default(cuid())
  username        String @unique
  email           String? @unique
  phoneNumber     String? @unique
  passwordHash    String?
  authPublicKey   String? @unique
  authAccountId   String? @unique
  credentialSalt String?
  contactLookup  String? @unique
  encryptedIdentifier String?
  publicUsername String? @unique
  publicDisplayName String?
  encryptedVault  String?
  vaultRevision   Int @default(0)
  appleId         String? @unique
  googleId        String? @unique
  displayName     String
  profilePicture  String?
  bio             String?
  status          String @default("ACTIVE")
  lastActiveAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  contacts        Contact[]
  contactedBy     Contact[] @relation("contactedBy")
  conversations   ConversationParticipant[]
  deviceTokens    DeviceToken[]
  secureDevices   SecureDevice[]
  invitations     Invitation[]
  acceptedInvitation Invitation? @relation("AcceptedInvitation")
  blocks          Block[]
  blockedBy       Block[] @relation("blockedBy")
  messages        Message[]
  reactions       MessageReaction[]
  reportsSubmitted Report[] @relation("ReportReporter")
  reportsReceived  Report[] @relation("ReportSubject")

  @@index([username])
  @@index([email])
  @@index([phoneNumber])
}

model Contact {
  id              String @id @default(cuid())
  userId          String
  contactUserId   String
  groupName       String // Family 1, All Contacts 1, Work 1, Project 1, School 1, Class 1, etc.
  nickname        String?
  isFavorite      Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactUser     User @relation("contactedBy", fields: [contactUserId], references: [id], onDelete: Cascade)

  @@unique([userId, contactUserId])
  @@index([userId])
  @@index([groupName])
}

model WebAppInstallation {
  installationId String @id
  createdAt      DateTime @default(now())
}

model Conversation {
  id              String @id @default(cuid())
  name            String?
  kind            String @default("CHAT") // CHAT, WELCOME
  isGroupChat     Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastMessageAt   DateTime?

  participants    ConversationParticipant[]
  messages        Message[]
  secureDispatches SecureDispatch[]

  @@index([createdAt])
  @@index([kind, lastMessageAt])
}

model ConversationParticipant {
  id              String @id @default(cuid())
  conversationId  String
  userId          String
  role            String @default("MEMBER")
  joinedAt        DateTime @default(now())
  lastReadAt      DateTime?

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model DeviceToken {
  id              String @id @default(cuid())
  userId          String
  token           String @unique
  platform        String // ios, android, web
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Operational topology only; invitation labels and owner history remain encrypted.
model PrivateInvitation {
  code            String @id
  status          String @default("PENDING")
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  inviterId       String?
  inviterDisplayName String?
  acceptedById    String? @unique
  acceptedAt      DateTime?
}

model Invitation {
  id              String @id @default(cuid())
  inviterId       String
  inviteeEmail    String?
  code            String @unique
  status          String @default("PENDING")
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  acceptedAt      DateTime?
  acceptedById    String? @unique

  inviter         User @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  acceptedBy      User? @relation("AcceptedInvitation", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([inviteeEmail])
  @@index([code])
}

model Block {
  id              String @id @default(cuid())
  userId          String
  blockedUserId   String
  createdAt       DateTime @default(now())

  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  blockedUser     User @relation("blockedBy", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedUserId])
  @@index([userId])
}

model Message {
  id              String @id @default(cuid())
  conversationId  String
  senderId        String
  clientMessageId String?
  automaticWelcome Boolean @default(false)
  content         String?
  messageType     String @default("TEXT") // TEXT, IMAGE, VIDEO, VOICE, DRAWING
  mediaUrl        String?
  thumbnailUrl    String?
  duration        Int?
  width           Int?
  height          Int?
  fileName        String?
  fileSize        Int?
  replyToId       String?
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo         Message? @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[] @relation("MessageReplies")
  reactions       MessageReaction[]
  reports         Report[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@unique([senderId, clientMessageId])
}

model MessageReaction {
  id              String @id @default(cuid())
  messageId       String
  userId          String
  emoji           String
  createdAt       DateTime @default(now())

  message         Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Report {
  id              String   @id @default(cuid())
  reporterId      String?
  reportedUserId  String?
  messageId       String?
  category        String
  details         String?
  contentSnapshot String?
  status          String   @default("OPEN")
  createdAt       DateTime @default(now())
  reviewedAt      DateTime?

  reporter     User?    @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedUser User?    @relation("ReportSubject", fields: [reportedUserId], references: [id], onDelete: SetNull)
  message      Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([reporterId, createdAt])
  @@index([reportedUserId, status])
  @@index([messageId])
  @@index([status, createdAt])
}

// Public identity keys only. Device identifiers and keys are immutable.
model SecureDevice {
  deviceId  String @id
  userId    String
  publicKey String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelopes SecureEnvelope[]

  @@index([userId])
}

// Content-free receipts survive queue deletion for replay and operation authorization.
model SecureDispatch {
  id             String @id
  digest         String
  conversationId String
  messageId      String
  kind           String
  senderId       String
  senderDeviceId String
  senderPublicKey String
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  payload        SecurePayload?
  envelopes      SecureEnvelope[]

  @@index([conversationId, messageId, kind])
}

model SecurePayload {
  dispatchId String @id
  ciphertext Bytes
  dispatch   SecureDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
}

model SecureEnvelope {
  dispatchId String
  deviceId   String
  nonce      String
  wrappedKey String
  dispatch   SecureDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  device     SecureDevice @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@id([dispatchId, deviceId])
  @@index([deviceId])
}
