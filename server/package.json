{
  "name": "looptalk-server",
  "version": "1.0.0",
  "description": "LoopTalk Next.js server with Socket.io and Prisma",
  "main": "src/server.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --dev",
    "test": "node --test",
    "check": "node scripts/check.js",
    "smoke:release": "node scripts/release-smoke.js",
    "reset": "node scripts/reset.js --confirm-reset",
    "db:seed": "node scripts/seed.js",
    "prisma:generate": "node scripts/prisma.js generate",
    "privacy:key": "node scripts/privacy-key.js",
    "db:push": "node scripts/prisma.js db push --skip-generate",
    "db:reset": "node scripts/reset.js --database-only",
    "db:studio": "node scripts/prisma.js studio",
    "db:setup": "npm run prisma:generate && npm run db:push"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@sentry/node": "^10.68.0",
    "@socket.io/redis-streams-adapter": "^0.3.1",
    "axios": "1.18.1",
    "bcryptjs": "3.0.3",
    "cheerio": "1.2.0",
    "cors": "2.8.6",
    "dotenv": "16.4.5",
    "expo-server-sdk": "^6.1.0",
    "express": "5.2.1",
    "express-rate-limit": "8.6.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.2.0",
    "prisma": "5.22.0",
    "redis": "^6.1.0",
    "sharp": "0.35.3",
    "socket.io": "4.8.3",
    "uuid": "11.1.1"
  },
  "overrides": {
    "ws": "^8.21.1",
    "cookie": "^2.0.1",
    "postcss": "^8.5.18",
    "sharp": "0.35.3"
  }
}
