{
  "name": "looptalk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "npm ci --omit=dev --prefix server && npm run prisma:generate --prefix server",
    "dev": "npm run dev --prefix server",
    "start": "npm start --prefix server",
    "build": "next build --webpack",
    "branding:generate": "node mobile/scripts/generate-brand-assets.js",
    "export:web": "npm run export:web --prefix mobile",
    "prisma:generate": "npm run prisma:generate --prefix server",
    "reset": "node server/scripts/reset.js --confirm-reset",
    "check": "npm run check --prefix server && npm run test:client && npm run check --prefix mobile",
    "release:prepare": "npm run check && npm run export:web && npm run build",
    "test": "npm test --prefix server && npm run test:client",
    "test:client": "node --test mobile/test/*.test.cjs",
    "zip": "git archive -o looptalk.zip HEAD"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "axios": "^1.18.1",
    "d3-hierarchy": "^3.1.2",
    "expo": "^57.0.8",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "^57.0.7",
    "expo-audio": "~57.0.3",
    "expo-auth-session": "~57.0.6",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "^57.0.1",
    "expo-font": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-image-picker": "^57.0.6",
    "expo-notifications": "^57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.7",
    "expo-splash-screen": "~57.0.5",
    "expo-video": "~57.0.2",
    "expo-video-thumbnails": "^57.0.1",
    "expo-web-browser": "~57.0.2",
    "graphology": "^0.26.0",
    "i18n-js": "^4.5.3",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "^0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "^5.1.1",
    "react-native-web": "^0.21.2",
    "sigma": "^4.0.0",
    "socket.io-client": "^4.8.3",
    "tweetnacl": "1.0.3",
    "tweetnacl-util": "0.15.1",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "0.35.3",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "babel-loader": "^10.1.1",
    "babel-preset-expo": "^57.0.4"
  }
}
