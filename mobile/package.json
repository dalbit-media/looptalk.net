{
  "name": "looptalk-mobile",
  "version": "1.0.0",
  "description": "LoopTalk - Cross-platform messenger app",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "check": "expo-doctor"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.1",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "7.18.14",
    "@react-navigation/native": "7.3.14",
    "@react-navigation/native-stack": "7.18.6",
    "@sentry/react-native": "~7.11.0",
    "axios": "1.18.1",
    "expo": "57.0.8",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "^57.0.7",
    "expo-audio": "~57.0.3",
    "expo-auth-session": "~57.0.5",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-document-picker": "^57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "^57.0.6",
    "expo-notifications": "57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-video": "~57.0.2",
    "expo-video-thumbnails": "^57.0.1",
    "expo-web-browser": "~57.0.2",
    "i18n-js": "4.5.3",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-callkeep": "^4.3.16",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-incall-manager": "^4.2.2",
    "react-native-localize": "3.7.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-url-polyfill": "4.0.0",
    "react-native-view-shot": "^5.1.0",
    "react-native-webrtc": "^124.0.8",
    "socket.io-client": "4.8.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "expo-doctor": "^1.20.1"
  },
  "private": true,
  "overrides": {
    "uuid": "11.1.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-constants",
        "expo-notifications",
        "react-native",
        "expo-image-picker",
        "expo-asset"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc",
          "react-native-incall-manager",
          "react-native-callkeep"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
